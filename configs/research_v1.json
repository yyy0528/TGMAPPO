{
  "environment": {
    "version": "research_v1",
    "backend": "reference_grid",
    "grid_size": 5,
    "comm_range": 1.5,
    "task_horizon": 80,
    "task_ttl": 80,
    "num_moving_buoys": 5,
    "mobility_std": 0.0,
    "loss_probability": 0.0,
    "reward_mode": "sparse"
  },
  "policy": {
    "backend": "geographic",
    "trainer": "graph_mappo",
    "rollout_length": 80,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "use_earp": false
  },
  "world_model": {
    "enabled": false,
    "backend": "local_graph_gru",
    "trainer": "supervised_wm",
    "history_len": 4,
    "hidden_size": 128,
    "batch_size": 16,
    "horizon": 1
  },
  "progress": {
    "enabled": false,
    "backend": "prefix_gru",
    "trainer": "supervised_pm",
    "hidden_size": 64,
    "batch_size": 16,
    "heads": 1,
    "alpha": 0.1,
    "update_mode": "frozen"
  },
  "data": {
    "replay_capacity_steps": 20000,
    "train_fraction": 0.7,
    "validation_fraction": 0.15
  },
  "runtime": {
    "seed": 12,
    "episodes": 3,
    "device": "auto",
    "output_root": "results/research"
  }
}
